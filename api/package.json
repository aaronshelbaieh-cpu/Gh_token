{
  "name": "ged-api",
  "version": "0.3.0",
  "private": true,
  "description": "Global Events Directory — API + Discovery Engine",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:smoke:discovery": "tsx scripts/smoke-discovery.ts",
    "discovery:generate": "tsx scripts/discovery-cli.ts generate",
    "discovery:run": "tsx scripts/discovery-cli.ts run",
    "discovery:stats": "tsx scripts/discovery-cli.ts stats"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
